# Dan's Bizarre Bazaar - Environment Variables
# Copy this file to .env.local and fill in your values

# ============================================
# SUPABASE CONFIGURATION
# ============================================

# Your Supabase project URL (from Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anon Key - for client-side operations (from Project Settings > API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key - for server-side operations (from Project Settings > API)
# ⚠️  NEVER expose this key to the client-side!
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================
# PRICING CONFIGURATION
# ============================================

# USD to MYR exchange rate (update periodically)
USD_MYR_RATE=4.70

# Default price multiplier (2.5, 2.8, or 3.0)
DEFAULT_MULTIPLIER=2.8

# ============================================
# API RATE LIMITING (optional)
# ============================================

# Delay between Scryfall API calls in milliseconds (default: 150)
SCRYFALL_DELAY_MS=150

# CardKingdom pricelist cache duration in hours (default: 24)
CKD_CACHE_HOURS=24

# ============================================
# DEPLOYMENT (Vercel)
# ============================================

# These are automatically set by Vercel from your project settings
# VERCEL_URL, VERCEL_ENV, etc.

# Production URL (after deployment)
NEXT_PUBLIC_SITE_URL=https://dbb.lovelikenotomorrow.com
